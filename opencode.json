      "type": "local",
      "command": [
        "uvx",
        "--python", "3.13",
        "--from", "ghidra-mcp[headless] @ git+https://github.com/LaurieWired/GhidraMCP",
        "ghidra-mcp",
        "--headless",
        "--binary", "C:\\corsairs-remake\\engine\\build\\default\\Debug\\engine.exe",
        "--extension-jar", "C:\\Users\\User\\AppData\\Local\\ghidramcp\\GhidraMCP.jar",
        "--ready-timeout", "600"
