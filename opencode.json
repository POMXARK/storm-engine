      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "windows": {
      "type": "local",
      "command": [
        "uvx",
        "windows-mcp",
        "serve"
