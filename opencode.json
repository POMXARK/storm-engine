{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama/qwen3.6-35b-a3b",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "duckduckgo": {
      "type": "local",
      "command": [
        "uvx",
        "duckduckgo-mcp-server"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "windows": {
      "type": "local",
      "command": [
        "uvx",
        "windows-mcp",
        "serve"
      ],
      "enabled": false
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "blender": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-for-blender"
      ],
      "enabled": false
    }
  },
  "provider": {
    "llama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "id": "qwen3.6-35b-a3b",
          "name": "Qwen3.6 35B A3B (local)",
          "attachment": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 16384
          }
        },
        "qwen3.8-27b": {
          "id": "qwen3.8-27b",
          "name": "Qwen3.8 27B dense (local)",
          "attachment": true,
          "reasoning": true,
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    }
  }
}
